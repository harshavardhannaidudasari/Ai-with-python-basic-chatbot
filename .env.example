# Copy this file to .env and fill in your values.
# Get an API key at https://console.anthropic.com/settings/keys

# LLM_PROVIDER: "claude" (default, needs ANTHROPIC_API_KEY), "groq" (needs
# GROQ_API_KEY — free tier, no card required: https://console.groq.com/keys),
# or "ollama" (needs a local Ollama server, https://ollama.com — no API key)
LLM_PROVIDER=claude

ANTHROPIC_API_KEY=sk-ant-...

# Model & generation settings
CLAUDE_MODEL=claude-opus-5
MAX_TOKENS=2048
CLAUDE_EFFORT=medium
SYSTEM_PROMPT=You are a helpful, concise AI assistant.

# Groq settings (only used when LLM_PROVIDER=groq)
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Voice mode's spoken replies — independent of LLM_PROVIDER above; used even
# if chat itself is served by Claude or Ollama. Default priority when more
# than one engine below is configured: clone > Gemini > Sarvam > Kokoro >
# Groq > (if every configured engine fails) the browser's built-in voice.
# Override that order with TTS_PROVIDER — e.g. set it to "sarvam" to prefer
# Sarvam for Indian-language replies even with GEMINI_API_KEY also set.
# TTS_PROVIDER=

# Gemini TTS: free, no card required, from https://aistudio.google.com/apikey
# — a much larger free-tier quota than Groq's (Groq's Orpheus free tier caps
# at 3,600 tokens/day, easy to exhaust in normal use). Preferred by default.
# 30 preset voices/characteristics: ai.google.dev/gemini-api/docs/speech-generation
GEMINI_API_KEY=AIza...
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore

# Sarvam AI TTS: free credits on signup, no card required, from
# https://dashboard.sarvam.ai. Its edge isn't English quality — it's native
# Hindi/Tamil/Telugu/etc. and Hinglish code-switching, which neither Gemini
# nor Groq handle natively. language_code is BCP-47 (en-IN, hi-IN, ...); full
# voice/language list: https://docs.sarvam.ai
SARVAM_API_KEY=sk_...
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_LANGUAGE=en-IN

# Kokoro TTS: free and unlimited (an 82M-parameter open-weight model running
# entirely locally — no API key, no daily quota), but off by default since
# it needs a heavy torch/transformers install (see requirements-kokoro.txt,
# same idea as voice cloning below, just a much smaller model) AND Python
# <3.13 — confirmed failing to install on 3.14 (a pinned numpy version plus
# a spacy/thinc/blis dependency chain with no 3.13/3.14 wheels yet). Voice
# list & quality grades: https://huggingface.co/hexgrad/Kokoro-82M/blob/main/VOICES.md
# KOKORO_TTS_ENABLED=true
KOKORO_TTS_VOICE=af_heart
KOKORO_TTS_LANG=a

# Groq Orpheus TTS: free tier, no card required: console.groq.com/keys.
# Female voices: hannah, autumn, diana. Male: troy, austin, daniel. Full
# voice list: console.groq.com/docs/text-to-speech
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=hannah

# Optional: clone a specific voice for voice mode instead of any preset
# above (see requirements-voice-clone.txt — a heavy, local-only, free
# option; not viable on Render's free tier, so leave unset
# there). Path to a 6s+ reference audio sample of the target voice.
# VOICE_CLONE_REFERENCE=data/voice_reference/reference.mp3
# VOICE_CLONE_LANGUAGE=en

# Ollama settings (only used when LLM_PROVIDER=ollama)
OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434
# Vision model used for image analysis when LLM_PROVIDER=ollama.
# (When LLM_PROVIDER=claude, image analysis uses Claude's own vision support instead.)
OLLAMA_VISION_MODEL=llava-phi3
# How long Ollama keeps a model loaded in memory after a request (Go duration
# string, e.g. "30m", "1h", or "-1" for forever). Higher = fewer reload
# stalls on repeat messages, at the cost of holding RAM longer.
OLLAMA_KEEP_ALIVE=30m
# Caps how many tokens a local Ollama reply can generate, bounding worst-case
# latency on slow/CPU-only hardware. 0 = unlimited.
OLLAMA_NUM_PREDICT=512

# RAG / knowledge base settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
MIN_SIMILARITY=0.2
RAG_ENABLED=true

# Storage paths (defaults shown)
DOCS_DIR=data/docs
INDEX_DIR=data/index

# Conversation memory
MAX_HISTORY_TURNS=20

# Web UI auth (required when the site is exposed publicly, e.g. via a tunnel)
# Generate values with: python -c "import secrets; print(secrets.token_urlsafe(12)); print(secrets.token_hex(32))"
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
# Stable secret so login sessions survive server restarts (keep this private)
FLASK_SECRET_KEY=change-me
