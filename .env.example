# Copy this file to .env and fill in your values.
# Get an API key at https://console.anthropic.com/settings/keys

# LLM_PROVIDER: "claude" (default, needs ANTHROPIC_API_KEY) or "ollama"
# (needs a local Ollama server, https://ollama.com — no API key required)
LLM_PROVIDER=claude

ANTHROPIC_API_KEY=sk-ant-...

# Model & generation settings
CLAUDE_MODEL=claude-opus-5
MAX_TOKENS=2048
CLAUDE_EFFORT=medium
SYSTEM_PROMPT=You are a helpful, concise AI assistant.

# Ollama settings (only used when LLM_PROVIDER=ollama)
OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434
# Vision model used for image analysis when LLM_PROVIDER=ollama.
# (When LLM_PROVIDER=claude, image analysis uses Claude's own vision support instead.)
OLLAMA_VISION_MODEL=llava-phi3

# RAG / knowledge base settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
MIN_SIMILARITY=0.2
RAG_ENABLED=true

# Storage paths (defaults shown)
DOCS_DIR=data/docs
INDEX_DIR=data/index

# Conversation memory
MAX_HISTORY_TURNS=20

# Web UI auth (required when the site is exposed publicly, e.g. via a tunnel)
# Generate values with: python -c "import secrets; print(secrets.token_urlsafe(12)); print(secrets.token_hex(32))"
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
# Stable secret so login sessions survive server restarts (keep this private)
FLASK_SECRET_KEY=change-me
